{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "livefoot.fun"
        }
      ],
      "destination": "https://www.livefoot.fun/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/match/:matchId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest)"
        }
      ],
      "destination": "/api/og-page/match/:matchId"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
